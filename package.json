{
  "name": "family-archive-document-ai",
  "type": "module",
  "version": "1.4.0",
  "private": true,
  "author": "Galliart Family",
  "license": "UNLICENSED",
  "_securityNotes": {
    "auditStatus": "0 vulnerabilities",
    "lastAudit": "2026-04-01",
    "resolved": [
      "sharp CVE-2023-4863 (HIGH) - override to ^0.33.5",
      "cookie GHSA-pxg6-pf52-xh8x (MODERATE) - override to ^0.7.2",
      "serialize-javascript GHSA-5c6j-r48x-rmvq (HIGH) - override to ^7.0.5",
      "serialize-javascript GHSA-qj8w-gfj5-8c6v (HIGH) - override to ^7.0.5",
      "brace-expansion GHSA-f886-m6hf-6m8v (MODERATE) - npm audit fix",
      "flatted GHSA-25h7-pfq9-p65f (HIGH) - npm audit fix",
      "flatted GHSA-rf6f-7fwh-wjgh (HIGH) - npm audit fix",
      "path-to-regexp GHSA-j3q9-mxjg-w52f (HIGH) - npm audit fix",
      "path-to-regexp GHSA-27v5-c462-wpq7 (HIGH) - npm audit fix",
      "picomatch GHSA-3v7f-55p6-f55p (HIGH) - npm audit fix",
      "picomatch GHSA-c2c7-rcm5-vvqj (HIGH) - npm audit fix",
      "yaml GHSA-48c2-rrv3-qjmp (MODERATE) - npm audit fix"
    ]
  },
  "workspaces": [
    "frontend",
    "backend/lambdas/*"
  ],
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "knip": "knip --no-progress",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint": "cd frontend && npm run check:lint -- --max-warnings 0 && npm run check:types",
    "check": "npm run lint && npm run test",
    "cleanup": "bash scripts/cleanup.sh --execute",
    "cleanup:dry": "bash scripts/cleanup.sh --report-only",
    "deploy": "bash backend/scripts/deploy.sh",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "test:e2e": "playwright test",
    "test:load": "artillery run tests/load/comments-load.yml && artillery run tests/load/messages-load.yml && artillery run tests/load/profile-load.yml",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,svelte}": [
      "bash -c 'cd frontend && npx eslint --max-warnings 0'"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-ses": "^3.1022.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "artillery": "^2.0.31",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "knip": "^6.11.0",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.0",
    "workbox-build": "^7.0.0",
    "workbox-window": "^7.0.0"
  },
  "overrides": {
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    },
    "serialize-javascript": "^7.0.5",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "remark-footnotes": "~4.0.1"
  }
}
