{
  "name": "family-archive-document-ai",
  "type": "module",
  "version": "1.4.0",
  "private": true,
  "author": "Galliart Family",
  "license": "UNLICENSED",
  "_securityNotes": {
    "auditStatus": "0 high/critical vulnerabilities",
    "lastAudit": "2026-07-24",
    "resolved": [
      "sharp CVE-2026-33327/33328/35590/35591 (HIGH) - override to ^0.35.3",
      "brace-expansion GHSA-v6h2-p8h4-qcjw (HIGH) - override to ^5.0.8; 5.x ships dual CJS/ESM so CJS consumers (minimatch, jake, oclif) resolve unchanged",
      "js-yaml GHSA-pm4m-ph32-ghv5 (HIGH) - pin markdownlint-cli2 to ^0.22.1 and scope its js-yaml to ^4.3.0; both markdownlint-cli2 lines ship a vulnerable js-yaml (0.22.x -> 4.1.1, 0.23.x -> 5.2.1), so the override is scoped rather than global to avoid forcing js-yaml 4's removal of safeLoad/safeDump on other consumers",
      "sharp CVE-2023-4863 (HIGH) - override to ^0.33.5",
      "cookie GHSA-pxg6-pf52-xh8x (MODERATE) - override to ^0.7.2",
      "serialize-javascript GHSA-5c6j-r48x-rmvq (HIGH) - override to ^7.0.5",
      "serialize-javascript GHSA-qj8w-gfj5-8c6v (HIGH) - override to ^7.0.5",
      "brace-expansion GHSA-f886-m6hf-6m8v (MODERATE) - npm audit fix",
      "flatted GHSA-25h7-pfq9-p65f (HIGH) - npm audit fix",
      "flatted GHSA-rf6f-7fwh-wjgh (HIGH) - npm audit fix",
      "path-to-regexp GHSA-j3q9-mxjg-w52f (HIGH) - npm audit fix",
      "path-to-regexp GHSA-27v5-c462-wpq7 (HIGH) - npm audit fix",
      "picomatch GHSA-3v7f-55p6-f55p (HIGH) - npm audit fix",
      "picomatch GHSA-c2c7-rcm5-vvqj (HIGH) - npm audit fix",
      "yaml GHSA-48c2-rrv3-qjmp (MODERATE) - npm audit fix"
    ]
  },
  "workspaces": [
    "frontend",
    "backend/lambdas/*"
  ],
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "knip": "knip --no-progress",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint": "cd frontend && npm run check:lint -- --max-warnings 0 && npm run check:types",
    "check": "npm run lint && npm run test",
    "cleanup": "bash scripts/cleanup.sh --execute",
    "cleanup:dry": "bash scripts/cleanup.sh --report-only",
    "deploy": "bash backend/scripts/deploy.sh",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "test:e2e": "playwright test",
    "test:load": "artillery run tests/load/comments-load.yml && artillery run tests/load/messages-load.yml && artillery run tests/load/profile-load.yml",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,svelte}": [
      "bash -c 'cd frontend && npx eslint --max-warnings 0'"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-ses": "^3.1095.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^4.1.10",
    "artillery": "^2.0.30",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.0.0"
  },
  "overrides": {
    "@opentelemetry/api": "^1.9.0",
    "brace-expansion": "^5.0.8",
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    },
    "markdownlint-cli2": {
      "js-yaml": "^4.3.0"
    },
    "serialize-javascript": "^7.0.5",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "remark-footnotes": "~4.0.1"
  }
}
